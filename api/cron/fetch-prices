import { createClient } from "@libsql/client";

const db = createClient({
  url: process.env.TURSO_DATABASE_URL,
  authToken: process.env.TURSO_AUTH_TOKEN,
});

export default async function handler(req, res) {
  // 1. Validate Secret Header
  const authHeader = req.headers.authorization;
  if (authHeader !== `Bearer ${process.env.CRON_SECRET}`) {
    return res.status(401).json({ error: "Unauthorized" });
  }

  try {
    // 2. Fetch SFL Data
    const response = await fetch("https://sfl.world/api/v1/prices");
    if (!response.ok) throw new Error(`SFL API status: ${response.status}`);
    const data = await response.json();

    const timestamp = new Date().toISOString();
    const batch = [];

    // 3. Prepare Batch Insert
    if (Array.isArray(data)) {
      data.forEach(item => {
        batch.push({
          sql: "INSERT INTO resource_prices (item_name, price, recorded_at) VALUES (?, ?, ?)",
          args: [item.name || item.resource, parseFloat(item.price || item.sfl || 0), timestamp],
        });
      });
    } else {
      Object.entries(data).forEach(([name, val]) => {
        const price = typeof val === "object" ? (val.price || val.sfl || 0) : val;
        batch.push({
          sql: "INSERT INTO resource_prices (item_name, price, recorded_at) VALUES (?, ?, ?)",
          args: [name, parseFloat(price), timestamp],
        });
      });
    }

    // 4. Batch Execute in Turso
    await db.batch(batch, "write");

    return res.status(200).json({ success: true, itemsRecorded: batch.length, timestamp });
  } catch (err) {
    console.error("Cron sync error:", err);
    return res.status(500).json({ error: err.message });
  }
}
